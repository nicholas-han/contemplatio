{
  "name": "weibo-semantic-filter",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node scripts/browser-test.mjs",
    "package": "npm run check && npm test && npm run build && node scripts/package.mjs",
    "evaluate": "node --import tsx scripts/evaluate.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.9",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
